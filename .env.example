# Google service account key file (relative to project root or absolute).
GOOGLE_SERVICE_ACCOUNT_FILE=config/service.json

# Google Sheet to read the SCM export from.
SHEET_ID=your_google_sheet_id_here
WORKSHEET_NAME=SCM_Export

# Month to filter the country overdue breakup on. Accepts a full name
# (JUNE), a 3-letter abbreviation (JUN), or a number (6 or 06).
# Leave blank to auto-use the latest month present in the sheet.
REPORT_MONTH=

# Reporting year (e.g. 2027). Leave blank to auto-use the latest year
# present in the sheet's Year column.
REPORT_YEAR=

# Apps Script Web App /exec URL that filters the sheet by country when a
# report's "Over Due Breakup" number is clicked (see appscript/CountryFilterLink.gs).
# Leave blank to render those numbers as plain (non-clickable) text.
FILTER_WEBAPP_URL=

# Workspace user to impersonate for Sheets access (domain-wide delegation).
# Leave empty to instead share the sheet with the service account email.
GOOGLE_DELEGATED_USER=you@yourcompany.com

# Email sending via SMTP. For Gmail, SMTP_PASSWORD must be an App Password
# (Google Account > Security > 2-Step Verification > App passwords).
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=you@gmail.com
SMTP_PASSWORD=your_app_password
EMAIL_SENDER=you@gmail.com

# Who receives the report. For multiple people, separate addresses with a
# comma or semicolon (spaces around them are fine) — every address gets the
# email, e.g.:
#   EMAIL_RECIPIENT=a@yourcompany.com, b@yourcompany.com, c@yourcompany.com
EMAIL_RECIPIENT=recipient@yourcompany.com
# Base subject; the app appends the month + a timestamp so each send is unique
# (looped emails won't collapse into a single Gmail thread).
EMAIL_SUBJECT=Export KPI Report

# Gemini AI summary (optional). Get a key at https://aistudio.google.com/apikey.
# Leave GEMINI_API_KEY empty to skip the AI summary.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Web server bind address/port (used by `uv run python -m app.main` and PM2).
# start.bat / email.bat read PORT from this file too, so change it here only.
HOST=0.0.0.0
PORT=8000
